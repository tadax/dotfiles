#!/bin/bash

# apt
sudo apt update -y
sudo apt upgrade -y
sudo apt install -y \
  vim \
  git \
  tree \
  curl \
  wget \
  pwgen \
  net-tools \
  openssh-server \
  tmux \
  ffmpeg \
  xsel

# vim
if [ -e $HOME/.vimrc ]
then
    echo "\"$HOME/.vimrc\" already exists."
else
    cp .vimrc $HOME/.vimrc
fi

# ssh
if [ ! -d $HOME/.ssh/ ]
then
    mkdir $HOME/.ssh/
fi
if [ -e $HOME/.ssh/config ]
then
    echo "\"$HOME/.ssh/config\" already exists."
else
    cp .ssh_config $HOME/.ssh/config
fi

# git
git config --global user.name tadax
git config --global user.email tadax@users.noreply.github.com
git config --global core.editor "vim"
git config --global core.filemode false
git config --global init.defaultBranch master
git config --global pull.rebase false  # the default strategy
git config --global push.default current  # cf. https://qiita.com/erii/items/e107b91a58f8250838da

# pyenv
# cf. https://github.com/pyenv/pyenv/wiki#suggested-build-environment
PYTHON_VERSION="3.11.5"
sudo apt update -y
sudo apt install -y build-essential libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev curl libncursesw5-dev xz-utils tk-dev libxml2-dev libxmlsec1-dev libffi-dev liblzma-dev
if [ ! -d $HOME/.pyenv ]
then
    git clone https://github.com/pyenv/pyenv.git $HOME/.pyenv
    echo -e '\n# pyenv' >> $HOME/.bashrc
    echo 'export PYENV_ROOT="$HOME/.pyenv"' >> ~/.bashrc
    echo 'command -v pyenv >/dev/null || export PATH="$PYENV_ROOT/bin:$PATH"' >> ~/.bashrc
    echo 'eval "$(pyenv init -)"' >> ~/.bashrc
    # cf. https://askubuntu.com/questions/64387/cannot-successfully-source-bashrc-from-a-shell-script
    eval "$(cat ~/.bashrc | tail -n 3)"
fi
if [ ! "$(python -V)" = "Python "$PYTHON_VERSION ]
then
    pyenv install $PYTHON_VERSION
    pyenv global $PYTHON_VERSION
    pip install -U pip
fi

# support 日本語入力
sudo apt update -y
sudo apt install ibus-mozc -y
echo "Computer reboot is required"

# install vlc
sudo snap install vlc

# install font
# https://pcaro.es/hermit/
sudo cp fonts/Hermit-Regular.otf /usr/local/share/fonts

# node
sudo apt install -y node
# https://github.com/tj/n
sudo npm install -g n
sudo n latest
