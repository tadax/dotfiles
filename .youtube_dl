#!/bin/bash

if [ ! -d ${HOME}/.youtube-dl/ ]
then
    git clone https://github.com/ytdl-org/youtube-dl.git ${HOME}/.youtube-dl
    cat << 'EOF' >> ~/.bashrc

# youtube-dl
function youtube-dl() {
    local current_dir=$(pwd)
    cd "${HOME}/.youtube-dl" || return
    python -m youtube_dl \
      -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best" \
      "$@" \
      --output "${current_dir}/%(title)s-%(id)s.%(ext)s"
    cd "$current_dir"
}
EOF
fi 

current_dir=$(pwd)
cd ${HOME}/.youtube-dl/ && git pull && cd "$current_dir"
