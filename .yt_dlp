#!/bin/bash

if [ ! -d ${HOME}/.yt-dlp/ ]
then
    git clone https://github.com/yt-dlp/yt-dlp.git ${HOME}/.yt-dlp
    cat << 'EOF' >> ~/.bashrc

# yt-dlp
function yt-dlp() {
    if [ "$#" -eq 0 ]; then
        echo "Usage: yt-dlp [OPTIONS] URL [URL...]"
        return
    fi
    
    local current_dir=$(pwd)
    cd "${HOME}/.yt-dlp" || return

    # Get filename
    local filename=$(
        python -m yt_dlp \
        -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best" \
        "$@" \
        --print "%(title)s-%(id)s.%(ext)s"
    )

    # Download a video
    python -m yt_dlp \
        -f "bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best" \
        "$@" \
        --output "${current_dir}/${filename}"

    # Save thumbnail
    python -m yt_dlp \
        "$@" \
        --write-thumbnail \
        --convert-thumbnails jpg \
        --skip-download \
        --output "${current_dir}/%(title)s-%(id)s.%(ext)s.jpg"

    cd "$current_dir"
}
EOF
fi 

current_dir=$(pwd)
cd ${HOME}/.yt-dlp/ && git pull && cd "$current_dir"
